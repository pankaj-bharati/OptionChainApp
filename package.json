{
  "name": "nse-option-chain-app",
  "version": "1.0.0",
  "description": "NSE Option Chain Viewer — Node.js backend + React frontend + Electron Windows app",
  "author": {
    "name": "NSE Option Chain",
    "email": "admin@localhost"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "server":       "cd server && npm start",
    "client":       "cd client && npm run dev",
    "dev":          "concurrently \"npm run server\" \"npm run client\"",
    "start":        "concurrently \"npm run server\" \"npm run client\"",
    "install-all":  "npm install && cd server && npm install && cd ../client && npm install",
    "electron:dev": "npm run build:client && electron .",
    "build:client": "cd client && npm run build",
    "build:win":    "scripts\\build-all.cmd",
    "build:exe":    "scripts\\build-exe.cmd",
    "build:msi":    "scripts\\build-msi.cmd",
    "build:zip":    "scripts\\build-zip.cmd"
  },
  "dependencies": {
    "concurrently": "^8.2.0"
  },
  "devDependencies": {
    "electron":         "30.5.1",
    "electron-builder": "24.13.3",
    "png-to-ico":       "2.1.8"
  }
}
